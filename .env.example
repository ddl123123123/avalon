# DeepSeek is called only by the server. Never put the real key in the frontend or Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional server-side OpenAI-compatible bot profiles and role defaults.
# AVALON_BOT_MODELS='[{"id":"alt","label":"备用模型","baseUrl":"https://provider.example/v1","model":"model-id","apiKeyEnv":"ALT_BOT_KEY"}]'
# AVALON_BOT_API_KEYS='{"ALT_BOT_KEY":"replace-on-server"}'
# AVALON_BOT_ROLE_MODELS='{"merlin":"deepseek","assassin":"alt","servant":"local"}'

# 账号与统计数据库。线上是共用 Postgres 实例里的 tabletop 库；
# 本地不填就用进程内的 PGlite，数据在仓库根目录的 .data/pglite（TABLETOP_DATA_DIR 可改）。
# DATABASE_URL=postgres://tabletop:password@localhost:5432/tabletop
