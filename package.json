{
  "name": "tabletop",
  "private": true,
  "description": "在浏览器里和朋友玩桌游：阿瓦隆、富饶之城、琉璃工坊",
  "homepage": "https://games.anois.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddl123123123/avalon.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": "9.x"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,yellow \"SERVER_PORT=8790 pnpm --filter @tabletop/server dev\" \"pnpm --filter @tabletop/web dev\"",
    "build": "pnpm --filter @tabletop/web build",
    "start": "pnpm --filter @tabletop/server start",
    "test": "pnpm --filter @tabletop/shared test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
